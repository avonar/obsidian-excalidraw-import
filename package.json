{
    "name": "excalidraw-import",
    "version": "1.0.1",
    "description": "Import Excalidraw scenes from excalidraw.com share links into Obsidian",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "test": "npm run compile-tests && mocha out/test/suite/*.test.js --timeout 10000",
        "compile-tests": "tsc -p . -outDir out"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "excalidraw"
    ],
    "author": "avonar",
    "license": "MIT",
    "devDependencies": {
        "@types/mocha": "^10.0.1",
        "@types/node": "^20.19.25",
        "@types/pako": "^2.0.4",
        "esbuild": "^0.27.0",
        "mocha": "^10.2.0",
        "obsidian": "^1.10.3",
        "tslib": "^2.8.1",
        "typescript": "^5.1.3"
    },
    "dependencies": {
        "firebase": "^10.14.1",
        "pako": "^2.2.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/avonar/obsidian-excalidraw-import.git"
    }
}
